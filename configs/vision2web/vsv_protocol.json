    "gemini3flash": {
      "provider": "openai-compatible",
      "model": "gemini-3-flash-preview",
      "base_url": "${OPENAI_BASE_URL}",
      "api_key_env": "OPENAI_API_KEY",
      "temperature": 1.0,
      "reasoning_effort": "high",
      "max_tokens": 16384,
      "timeout": 900,
      "retries": 0,
      "json_mode": true,
