        "type": "enabled"
      },
      "reasoning_effort": "high",
      "max_tokens": 16384,
      "timeout": 900,
      "retries": 0,
      "json_mode": true
    },
    "gpt54": {
      "provider": "openai-compatible",
      "model": "gpt-5.4",
      "base_url": "${OPENAI_BASE_URL}",
      "api_key_env": "OPENAI_API_KEY",
