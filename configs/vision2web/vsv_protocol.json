    "text_vc": "gemini3flash",
    "visual_vc": "gemini3flash",
    "text_cv": "gemini3flash",
    "visual_cv": "gemini3flash",
    "text_bda": "gemini3flash",
    "visual_bda": "gemini3flash",
    "text_rs": "gemini3flash",
    "visual_rs": "gemini3flash",
    "text_cp": "gemini3flash",
    "visual_cp": "gemini3flash",
